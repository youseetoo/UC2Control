<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================================================================
         Base theme. Light, per the brand guide: #FAF9F9 body, #023773 blue
         as the main brand colour. Deliberately not DayNight — the palette is
         the brand's, and it should look the same on every phone.
         =================================================================== -->
    <style name="Theme.UC2Control" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
    </style>

    <!-- ===================================================================
         Typography. Stolzl is a licensed font and cannot ship in an open
         repo; Space Grotesk is the substitute already used by the openUC2
         web frontend, so the two stay visually consistent.
         =================================================================== -->
    <!-- Base for the Text.* family; dotted names imply this as their parent. -->
    <style name="Text" />

    <style name="Text.Display">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <style name="Text.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="Text.Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Text.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:layout_marginBottom">3dp</item>
    </style>

    <style name="Text.AxisLabel">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Text.Mono">
        <item name="android:fontFamily">@font/ibm_plex_mono</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ===================================================================
         Containers
         =================================================================== -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="FieldColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- ===================================================================
         Inputs
         =================================================================== -->
    <style name="NumberInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:inputType">numberSigned</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:fontFamily">@font/ibm_plex_mono</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- ===================================================================
         Buttons. All flat, brand-coloured, sentence case.
         =================================================================== -->
    <style name="Btn" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <style name="Btn.Accent">
        <item name="backgroundTint">@color/accent</item>
    </style>

    <style name="Btn.Go">
        <item name="backgroundTint">@color/go</item>
    </style>

    <style name="Btn.Danger">
        <item name="backgroundTint">@color/danger</item>
    </style>

    <style name="Btn.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Jog buttons: equal-width cells in a row -->
    <style name="Btn.Jog">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="Btn.Jog.Continuous">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Btn.Jog.Stop">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Small on/off pair used by the light + LED sections -->
    <style name="Btn.Small">
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Btn.Small.On">
        <item name="backgroundTint">@color/go</item>
    </style>

    <style name="Btn.Small.Off">
        <item name="backgroundTint">@color/uc2_grey</item>
    </style>
</resources>
